<UserControl
    x:Class="Translumo.MVVM.Views.LanguagesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:Translumo.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:translation="clr-namespace:Translumo.Translation;assembly=Translumo.Translation"
    xmlns:tts="clr-namespace:Translumo.TTS;assembly=Translumo.TTS"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="dataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="translation:Translators" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider
            x:Key="ttsSystems"
            MethodName="GetValues"
            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="tts:TTSEngines" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Width="800" Margin="0,0,0,-1113">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="475" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Margin" Value="0,0,0,20" />
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <ComboBox
                    DisplayMemberPath="DisplayName"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableLanguages}"
                    SelectedValue="{Binding Path=TranslateFromLang}"
                    SelectedValuePath="LanguageDescriptor.Language"
                    Style="{StaticResource ComboBoxBase}" />
                    <Label
                    Margin="12,0,0,0"
                    Content="{DynamicResource Str.LangSettings.SourceLang}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox
                    DisplayMemberPath="DisplayName"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableTranslationLanguages}"
                    MaxDropDownHeight="300"
                    SelectedValue="{Binding Path=TranslateToLang}"
                    SelectedValuePath="LanguageDescriptor.Language"
                    Style="{StaticResource ComboBoxBase}" />
                    <Label
                    Margin="12,0,0,0"
                    Content="{DynamicResource Str.LangSettings.TranslationLang}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox
                    Width="130"
                    FontSize="14"
                    ItemsSource="{Binding Source={StaticResource dataFromEnum}}"
                    SelectedItem="{Binding Path=Translator}"
                    Style="{StaticResource ComboBoxBase}" />
                    <Label
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.Translator}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDeeplSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBox
                    Width="220"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Text="{Binding DeeplApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <Label
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.DeeplApiKey}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsYandexSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBox
                    Width="220"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Text="{Binding YandexApiKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <Label
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.YandexApiKey}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <!-- LibreTranslate -->
            <StackPanel Visibility="{Binding IsLibreTranslateSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Server URL Input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox
                    Width="200"
                    FontSize="14"
                    Text="{Binding Path=Model.LibreTranslateUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.LibreServerUrl}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>

                <!-- Control Row: Test Button + Help Button (?) + Feedback -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button
                    Command="{Binding RunLibreTranslateCommand}"
                    Content="{DynamicResource Str.LangSettings.RunLibre}"
                    IsEnabled="{Binding CanTestLibreTranslate}"
                    Style="{StaticResource PrimaryButton}" />

                    <!-- Help Toggle Button (?) -->
                    <Button
                    Margin="10,0,0,0"
                    Command="{Binding ToggleLibreTranslateGuideCommand}"
                    Content="{DynamicResource Str.LangSettings.LibreGuideBtn}"
                    ToolTip="Toggle installation &amp; docker guide"
                    Style="{StaticResource RoundSecondaryButton}"
                    Width="36"
                    Height="32"
                    Padding="0" />

                    <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding LibreTranslateTestResultColor}"
                    Text="{Binding LibreTranslateTestResult}"
                    TextWrapping="WrapWithOverflow" />
                </StackPanel>

            </StackPanel>
            <!--NVIDIA Riva-->
            <StackPanel Visibility="{Binding IsRivaSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Server URL Input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox
                    Width="250"
                    FontSize="14"
                    Text="{Binding Path=Model.RivaUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.RivaEndpointUrl}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>

                <!-- API Key Input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox
                    Width="250"
                    FontSize="14"
                    Text="{Binding Path=Model.RivaApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.RivaApiKey}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>

                <!-- Test Button and Feedback -->
                <StackPanel Orientation="Horizontal">
                    <Button
                    Command="{Binding TestRivaCommand}"
                    Content="{DynamicResource Str.LangSettings.RivaTestConnection}"
                    IsEnabled="{Binding CanTestRiva}"
                    Style="{StaticResource PrimaryButton}" />

                    <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding RivaTestResultColor}"
                    Text="{Binding RivaTestResult}"
                    TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </StackPanel>
            <!--AI Translator Configuration (BYOK)-->
            <StackPanel Visibility="{Binding IsAiTranslatorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Provider selection -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox
                    Width="200"
                    FontSize="14"
                    ItemsSource="{Binding AvailableAiProviders}"
                    SelectedItem="{Binding Model.AiProvider}"
                    Style="{DynamicResource MaterialDesignComboBox}" />
                    <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.AiTransAiProvider}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>

                <!-- API Key input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox
                    Width="200"
                    FontSize="14"
                    Text="{Binding CurrentAiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.AiTransApiKey}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>

                <!-- Model input -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox
                    Width="200"
                    FontSize="14"
                    Text="{Binding CurrentAiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label
                    Margin="10,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.AiTransModelIdentifier}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel>
                    <Label
                    Margin="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{Binding AiModelCaptionDefault, Mode=OneWay}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>

                <!-- Test Button and Feedback -->
                <StackPanel Orientation="Horizontal">
                    <Button
                    Command="{Binding TestAiCommand}"
                    Content="{DynamicResource Str.LangSettings.AiTransTestConnection}"
                    IsEnabled="{Binding CanTestAi}"
                    Style="{StaticResource PrimaryButton}" />

                    <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{Binding AiTestResultColor}"
                    Text="{Binding AiTestResult}"
                    TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </StackPanel>
            <!--ONNX-->
            <StackPanel Visibility="{Binding IsOnnxSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel
                            Orientation="Horizontal">
                    <controls:NumericInput
                            Maximum="4"
                            Minimum="1"
                            Value="{Binding Model.BeamCount, Mode=TwoWay}" />
                    <Label Content="{DynamicResource Str.LangSettings.BeamCount}" Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel>
                    <Label
                    Margin="0,-15,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.BeamCountInfo}"
                    Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Help Toggle Button (?) -->
                    <Button
                    Margin="0,-15,0,0"
                    Command="{Binding ToggleOnnxManualGuideCommand}"
                    Content="{DynamicResource Str.LangSettings.OnnxInstGuideBtn}"
                    ToolTip="{DynamicResource Str.LangSettings.OnnxInstGuideTooltip}"
                    Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                Width="130"
                FontSize="14"
                ItemsSource="{Binding Source={StaticResource ttsSystems}}"
                SelectedItem="{Binding Path=TtsSystem}"
                Style="{StaticResource ComboBoxBase}" />
                <Label
                Margin="12,0,0,0"
                HorizontalAlignment="Stretch"
                Content="{DynamicResource Str.LangSettings.TtsSystem}"
                Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTtsWindowsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox 
                ItemsSource="{Binding AvailableVoices}"
                SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                DisplayMemberPath="Name"
                Width="130"
                FontSize="14"
                Style="{StaticResource ComboBoxBase}"/>
                <Label
                Margin="12,0,0,0"
                HorizontalAlignment="Stretch"
                Content="{DynamicResource Str.LangSettings.TtsVoices}"
                Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>